# Your Sleeper username (the app finds your Sleeper leagues and rosters from it).
SLEEPER_USERNAME=

# ESPN (optional). League ids from the league URL (leagueId=...), comma separated.
# For private leagues also paste the two cookies from your browser while logged in to fantasy.espn.com
# (DevTools -> Application -> Cookies -> espn.com). SWID keeps its curly braces.
ESPN_LEAGUE_IDS=
ESPN_S2=
ESPN_SWID=

# Optional: where to keep the cache, your planned moves and your handled news (default: ./data)
# ZFM_DATA_DIR=./data

# Timezone that waiver hours are read in. Sleeper stores a bare hour with no zone, so this is
# what turns "waivers process Wednesday at 0" into a real time on your clock.
# ZFM_TIMEZONE=America/New_York

# FantasyPros expert consensus ranks, read from their public rankings pages. Set to off to run on
# platform projections alone. ZFM_FP_DELAY is the pause between page fetches, in seconds; their
# robots.txt asks for 5, and a cold cache costs about seven pages.
# ZFM_FANTASYPROS=on
# ZFM_FP_DELAY=5

# Player news (RotoWire / FantasyPros / RotoBaller, via Sleeper's public feed).
# ZFM_NEWS=on
