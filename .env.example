# Your Sleeper username (the app finds your Sleeper leagues and rosters from it).
SLEEPER_USERNAME=

# ESPN (optional). League ids from the league URL (leagueId=...), comma separated.
# For private leagues also paste the two cookies from your browser while logged in to fantasy.espn.com
# (DevTools -> Application -> Cookies -> espn.com). SWID keeps its curly braces.
ESPN_LEAGUE_IDS=
ESPN_S2=
ESPN_SWID=

# Optional: where to keep the Sleeper cache and your planned moves (default: ./data)
# ZFM_DATA_DIR=./data
