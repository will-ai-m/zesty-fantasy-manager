# Your Sleeper username (the app finds your Sleeper leagues and rosters from it).
SLEEPER_USERNAME=

# ESPN (optional). League ids from the league URL (leagueId=...), comma separated.
# For private leagues also paste the two cookies from your browser while logged in to fantasy.espn.com
# (DevTools -> Application -> Cookies -> espn.com). SWID keeps its curly braces.
ESPN_LEAGUE_IDS=
ESPN_S2=
ESPN_SWID=

# Yahoo (optional). League id from the league URL (football.fantasysports.yahoo.com/f1/<id>), comma
# separated. YAHOO_COOKIE is the full Cookie header from your browser while logged in to Yahoo Fantasy
# (DevTools -> Network -> the /f1/<id> document request -> Request Headers -> copy the whole "Cookie:" value).
# Read-only; the session cookie authenticates reads of the logged-in football.fantasysports.yahoo.com
# pages. Cookies expire, so refresh this when Yahoo leagues start returning errors. See
# research/yahoo-cookie-access.md.
YAHOO_LEAGUE_IDS=
YAHOO_COOKIE=

# Optional: where to keep the Sleeper cache and your planned moves (default: ./data)
# ZFM_DATA_DIR=./data
